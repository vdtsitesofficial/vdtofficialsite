{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vdtsites",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // KV store for the /admin area: contact-form submissions, and later
  // editable blog posts + site copy.
  "kv_namespaces": [
    {
      "binding": "ADMIN_KV",
      "id": "c3690d7ca5fe41fdad5a6a7daec42775"
    },
    // Site copy for the vdt-site-kit inline editor, plus its save history.
    // Deliberately a SEPARATE namespace from ADMIN_KV: contact messages are
    // transient and get deleted, site copy is the site itself. Keeping them
    // apart means a careless prefix sweep on one can never touch the other.
    {
      "binding": "CONTENT_KV",
      "id": "d54e46e3b23b4958b936554e8ccdd5c0"
    },
    // OpenNext's ISR cache. Required to be WRITABLE now that the root layout
    // sets `revalidate`: see the note in open-next.config.ts. Machine-managed
    // cache entries only, safe to purge wholesale if it ever misbehaves.
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "5c9d9a3f47a843c59f95b904be022835"
    }
  ],
  // Custom domains. Cloudflare creates the DNS automatically on deploy.
  // vdtsites.com is the canonical site; www redirects/serves alongside it.
  // vdtsites.ca is intentionally NOT here - it 301-redirects to vdtsites.com
  // via a Cloudflare Redirect Rule, so it must not be a Worker route.
  // workers.dev stays live as a backup URL.
  "workers_dev": true,
  "routes": [
    { "pattern": "vdtsites.com", "custom_domain": true },
    { "pattern": "www.vdtsites.com", "custom_domain": true }
  ],
  // Cloudflare Workers Email Routing send_email binding. With no
  // destination_address set, the Worker may send to ANY address that is a
  // verified destination in Email Routing for this account (Email > Email
  // Routing > Destination Addresses). This powers both the contact-form
  // notification and the /admin sign-in PIN.
  //
  // Each admin email in ADMIN_EMAILS below MUST be verified as a
  // destination address, or its PIN email will not deliver.
  "send_email": [{ "name": "SEND_EMAIL" }],
  "vars": {
    // FROM address. Valid for BOTH delivery paths, which is why it is this
    // and not vdtsites.ca:
    //   - Resend (preferred): vdtsites.com is a verified sending domain
    //     (DKIM at resend._domainkey.vdtsites.com, bounce domain
    //     send.vdtsites.com). Do NOT be fooled by the apex SPF pointing at
    //     Cloudflare Email Routing - Resend authenticates the apex by DKIM
    //     and never uses the apex SPF.
    //   - send_email binding (fallback): requires the FROM domain to have
    //     Email Routing enabled on this account, and vdtsites.com does.
    // Standardised 2026-08-16 onto <name>@vdtsites.com across every VDT
    // site so sender reputation accrues to one domain instead of three.
    "CONTACT_FROM_EMAIL": "VDT Sites <contact@vdtsites.com>",
    // Displayed to the user as the contact destination; actual delivery
    // happens via the SEND_EMAIL binding above. NOTE: this address must
    // be a verified destination in Cloudflare Email Routing for the
    // account, or send_email returns a delivery error.
    "CONTACT_TO_EMAIL": "vdtsites@gmail.com",
    // Allowlist of admin emails that may sign in to /admin. Comma-separated.
    // Login is email-only (2026-08-15): a one-time PIN is emailed to the
    // address, sent via Resend when the RESEND_API_KEY secret is set, else
    // via the SEND_EMAIL binding (which requires the address to be a
    // verified Email Routing destination — vdtsites@gmail.com is).
    "ADMIN_EMAILS": "vdtsites@gmail.com,vanduist.sem@gmail.com"
  }
}
