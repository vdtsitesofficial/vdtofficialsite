# Local reference assets (mockup videos / screenshots dropped in the repo
# root for inspiration). Don't commit binaries to the project root.
/*.mp4
/*.mov
/*.webm
/videoframe_*.png

# Personal scratch dirs that don't belong in source control
/test/
/test
*.pdf
.env*.local
.DS_Store
*.log
.vercel
