*.deploy-secrets*

# dev/debug scratch (never ship)
/_render_*.js
/public/lab/_*
/public/lab/assets/*.old.png
/public/lab/assets/*.full.png

# responsive-audit sweep artifacts (screenshots + report JSON, regenerated per run)
responsive-audit-out*/

# vdt-site-kit dev fallback. With no CONTENT_KV binding (i.e. `next dev`) the
# kit reads and WRITES site copy to these paths. Committing either would bake
# local scratch copy into every prerendered page on the next CI deploy, since
# the build reads defaults, not KV.
/content.local.json
/public/uploads/
